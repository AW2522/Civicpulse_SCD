# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it (a committed .env/key/token is an automatic −20, see §5.3).

POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://civicpulse:changeme@localhost:5432/civicpulse
REDIS_URL=redis://localhost:6379/0

# Frontend API Endpoint configuration
VITE_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# simulated | rules | llm | ollama — use `simulated` for local/dev/CI runs
TRIAGE_PROVIDER=simulated

# Free-tier keys (see assignment §2.5) — leave blank if using rules/simulated/ollama
GROQ_API_KEY=
GEMINI_API_KEY=

# Only used by compose.prod.yaml (substituted by CI with the built image tag)
GHCR_OWNER=your-github-org-or-username
IMAGE_TAG=latest

